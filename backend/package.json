{
  "name": "haupcar-car-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RESTful API for the Haupcar car management system",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
